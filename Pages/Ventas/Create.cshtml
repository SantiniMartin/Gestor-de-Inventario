@page
@model GestionDeInventario.Pages.Ventas.CreateModel
@{
    ViewData["Title"] = "Nueva Venta";
}

<h1>Registrar Venta</h1>

<form method="post">
    <div class="mb-3">
        <label class="form-label">Cliente</label>
        <select asp-for="VentaForm.ClienteId" class="form-control">
            @foreach (var cliente in Model.Clientes)
            {
                <option value="@cliente.Id">@cliente.Nombre</option>
            }
        </select>
    </div>

    <h4>Productos</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Cantidad</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.VentaForm.ProductosSeleccionados.Count; i++)
            {
                <tr>
                    <td>@Model.VentaForm.ProductosSeleccionados[i].Nombre</td>
                    <td>$@Model.VentaForm.ProductosSeleccionados[i].Precio</td>
                    <td>@Model.VentaForm.ProductosSeleccionados[i].Stock</td>
                    <td>
                        <input asp-for="VentaForm.ProductosSeleccionados[@i].Cantidad" class="form-control" type="number" min="0" />
                        <input type="hidden" asp-for="VentaForm.ProductosSeleccionados[@i].ProductoId" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-success">Guardar Venta</button>
    <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
</form>
